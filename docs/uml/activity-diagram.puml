@startuml CaterFlowActivity

title Диаграмма деятельности — оформление и обработка заявки

skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #526579
    DiamondBackgroundColor #F8FAFC
    DiamondBorderColor #526579
    StartColor #526579
    EndColor #526579
    BarColor #8295A8
}
skinparam ArrowColor #526579

|Клиент|
start
:Просмотреть каталог блюд;

repeat
    :Сформировать меню\nили выбрать готовый набор;
    |CaterFlow|
    :Проверить доступность блюд;
    if (Все блюда доступны?) then (Нет)
        |Клиент|
        :Получить уведомление\nо недоступности блюд;
    endif
repeat while (Все блюда доступны?) is (Нет) not (Да)

|CaterFlow|
:Рассчитать предварительную\nстоимость меню и доставки;

|Клиент|
repeat
    :Указать данные мероприятия\nи контактную информацию;
    :Отправить заявку;
    |CaterFlow|
    :Проверить корректность данных;
    if (Данные корректны?) then (Нет)
        |Клиент|
        :Получить сообщение\nоб ошибках заполнения;
    endif
repeat while (Данные корректны?) is (Нет) not (Да)

|CaterFlow|
:Сохранить заявку в PostgreSQL;
if (Заявка сохранена?) then (Да)
    :Присвоить номер заявки;
    :Установить статус «Новая заявка»;
else (Нет)
    |Клиент|
    :Получить сообщение\nоб ошибке оформления;
    stop
endif

|Почтовый сервис|
fork
    :Отправить уведомление\nменеджеру о новой заявке;
fork again
    :Отправить клиенту\nподтверждение получения заявки;
end fork

|Менеджер|
:Просмотреть поступившую заявку;
:Изучить сведения и состав заказа;
if (Требуется изменение заявки?) then (Да)
    :Изменить состав заявки;
    |CaterFlow|
    :Пересчитать стоимость;
    :Сохранить изменения;
    |Менеджер|
endif

:Выбрать новый статус заявки;

|CaterFlow|
:Проверить права сотрудника;

if (Права подтверждены?) then (Да)
    :Сохранить новый статус;

    if (Новый статус — «Подтверждена»?) then (Да)
        |Почтовый сервис|
        :Отправить клиенту уведомление\nо подтверждении заявки;
    endif
else (Нет)
    |Менеджер|
    :Получить сообщение\nоб отказе в доступе;
endif

|Менеджер|
stop

@enduml